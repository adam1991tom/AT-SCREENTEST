<Window x:Class="ScreenTest.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AT ScreenTest — Control"
        Width="400" Height="680"
        MinWidth="340" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF202020">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Output monitor" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1" x:Name="MonitorCombo" Margin="0,0,0,14"
                  SelectionChanged="OnMonitorChanged" DisplayMemberPath="Label"/>

        <TextBlock Grid.Row="2" Text="Test pattern" FontWeight="Bold" Margin="0,0,0,4"/>
        <ListBox Grid.Row="3" x:Name="PatternList" Margin="0,0,0,10"
                  SelectionChanged="OnPatternChanged" DisplayMemberPath="Label"/>

        <TextBlock Grid.Row="4" x:Name="AdjustLabel" FontSize="11" Opacity="0.75" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="−" Click="OnAdjustDown" Width="40"/>
            <Button Content="+" Click="OnAdjustUp" Width="40"/>
            <Button Content="Rows −" Click="OnRowsDown"/>
            <Button Content="Rows +" Click="OnRowsUp"/>
        </StackPanel>

        <CheckBox Grid.Row="6" x:Name="OverlayCheck" Content="Show info overlay on output screen"
                  IsChecked="True" Checked="OnOverlayToggled" Unchecked="OnOverlayToggled" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" x:Name="StatusText" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
    </Grid>
</Window>
